flowchart TB

    WALFile[".dbclient/wal.jsonl\n(JSON Lines, append-only)"]

    subgraph Entry["Entrada WAL"]
        TID["tid"]
        TS["timestamp"]
        OP["op\nBEGIN / WRITE / COMMIT / ABORT"]
        ENG["engine\n(postgres | mongo)"]
        Q["query"]
        BEFORE["before"]
        AFTER["after"]
    end

    Append["wal.append(entry)"] --> WALFile
    WALFile --> Query["wal.query(tid, since, until)"]

    Append --> Entry
    Entry --> WALFile

    TID --> WALFile
    TS --> WALFile
    OP --> WALFile
    ENG --> WALFile
    Q --> WALFile
    BEFORE --> WALFile
    AFTER --> WALFile
