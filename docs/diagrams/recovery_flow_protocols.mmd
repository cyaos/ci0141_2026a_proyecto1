flowchart TD

    T["Procesos de recuperación"] --> D{¿Qué protocolo mostrar?}

    subgraph P3["P3: Undo / No-Redo"]
        P3A[BEGIN] --> P3B[INSERT / UPDATE]
        P3B --> P3C[Los cambios se ven en la BD]
        P3C --> P3D[simular_fallo: corte abrupto]
        P3D --> P3E[recuperar]
        P3E --> P3F[UNDO visible: los cambios desaparecen]
    end

    subgraph P2["P2: No-Undo / Redo"]
        P2A[BEGIN] --> P2B[INSERT / UPDATE]
        P2B --> P2C[Los cambios quedan bufferizados]
        P2C --> P2D[commit]
        P2D --> P2E[Los cambios se aplican a la BD]
        P2E --> P2F[recuperar lee WAL]
        P2F --> P2G{TID con COMMIT en WAL}
        P2G -->|sí| P2H[REDO: se reejecuta]
        P2G -->|no| P2I[Se ignora]
    end

    D -->|P3| P3A
    D -->|P2| P2A

    style P3 fill:#f9f2ff,stroke:#7a4cc2,stroke-width:1px
    style P2 fill:#f2fbff,stroke:#2b78c5,stroke-width:1px
    style T fill:#ffffff,stroke:#999999,stroke-dasharray: 4 4
